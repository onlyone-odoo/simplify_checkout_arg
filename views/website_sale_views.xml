<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit cart totals template: hide subtotal and taxes for simplified UX -->
    <template id="simplify_cart_total" inherit_id="website_sale.total">
        <!-- Hide subtotal (order_total_untaxed) -->
        <xpath expr="//tr[@id='order_total_untaxed']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <!-- Hide taxes (order_total_taxes) -->
        <xpath expr="//tr[@id='order_total_taxes']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </template>

    <!-- Inherit address template (website_sale.address): set defaults, hide all except name/email/phone -->
    <template id="simplify_address_defaults" inherit_id="website_sale.address">
        <!-- Set default country as Argentina (ID: 10) - inject options, hide div -->
        <xpath expr="//select[@name='country_id']" position="inside">
            <t t-set="default_country_id" t-value="10"/>
            <t t-set="selected_country" t-value="('country_id' in checkout and checkout['country_id']) or default_country_id"/>
            <t t-foreach="countries" t-as="c">
                <option t-att-value="c.id" t-att-selected="c.id == selected_country">
                    <t t-esc="c.name"/>
                </option>
            </t>
        </xpath>

        <!-- Set default state as Buenos Aires (ID: 554) - inject options, hide div -->
        <xpath expr="//select[@name='state_id']" position="inside">
            <t t-set="default_state_id" t-value="554"/>
            <t t-set="selected_state" t-value="('state_id' in checkout and checkout['state_id']) or default_state_id"/>
            <t t-foreach="country_states" t-as="s">
                <option t-att-value="s.id" t-att-selected="s.id == selected_state">
                    <t t-esc="s.name"/>
                </option>
            </t>
        </xpath>

        <!-- Hide company_name (if B2B) -->
        <!-- Inherited view to simplify address defaults for AR checkout -->

        <xpath expr="//div[label[@for='company_name']]">
            <!-- Your custom changes, e.g., add invisible="1" or whatever simplification -->
            <attribute name="t-if">False</attribute>  <!-- Or your logic -->
        </xpath>


        <!-- Set default VAT: 12345678,-->
        <xpath expr="//input[@name='vat']" position="attributes">
            <attribute name="t-att-value">('vat' in checkout and checkout['vat']) or '12345678'</attribute>
        </xpath>

        <!-- Set default street: ejemplo 1234, hide div -->
        <xpath expr="//input[@name='street']" position="attributes">
            <attribute name="t-att-value">('street' in checkout and checkout['street']) or 'ejemplo 1234'</attribute>
        </xpath>
        <xpath expr="//div[label[@for='street2']]" position="attributes">
            <attribute name="style">display: none;</attribute> <!-- Hide street -->
        </xpath>

        <!-- Set default city: Bahía Blanca, hide div -->
        <xpath expr="//input[@name='city']" position="attributes">
            <attribute name="t-att-value">('city' in checkout and checkout['city']) or 'CABA'</attribute>
        </xpath>

        <!-- Set default zip: 8000 - replace in first block -->
        <xpath expr="//t[@t-if=&quot;&#39;zip&#39; in zip_city and zip_city.index(&#39;zip&#39;) &lt; zip_city.index(&#39;city&#39;)&quot;]//input[@name='zip']" position="replace">
            <input type="text" name="zip" t-attf-class="form-control #{error.get('zip') and 'is-invalid' or ''}" t-att-value="('zip' in checkout and checkout['zip']) or '8000'"/>
        </xpath>

        <!-- Set default zip: 8000 - replace in second block -->
        <xpath expr="//t[@t-if=&quot;&#39;zip&#39; in zip_city and zip_city.index(&#39;zip&#39;) &gt; zip_city.index(&#39;city&#39;)&quot;]//input[@name='zip']" position="replace">
            <input type="text" name="zip" t-attf-class="form-control #{error.get('zip') and 'is-invalid' or ''}" t-att-value="('zip' in checkout and checkout['zip']) or '8000'"/>
        </xpath>

        <!-- Set default email: ejemplo@ejemplo.com (visible) -->
        <xpath expr="//input[@name='email']" position="attributes">
            <attribute name="t-att-value">('email' in checkout and checkout['email']) or 'ejemplo@ejemplo.com'</attribute>
        </xpath>

        <!-- Hide "Ship to same address" checkbox -->
        <xpath expr="//div[contains(@class, 'form-check') and .//input[@name='use_same']]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>

    </template>

    <!-- Change payment submit button label -->
    <template id="simplify_payment_submit_button" inherit_id="payment.submit_button">
        <xpath expr="//button[@name='o_payment_submit_button']" position="before">
            <t t-set="submit_button_label">Confirmar reserva</t>
        </xpath>
    </template>

    <!-- Inherit l10n_ar partner info: set defaults and hide blocks -->
    <template id="simplify_ar_partner_info_defaults" inherit_id="l10n_ar_website_sale.partner_info">
        <!-- Set default AFIP Responsibility (ID: 5) - inject, hide div -->
        <xpath expr="//select[@name='l10n_ar_afip_responsibility_type_id']" position="inside">
            <t t-set="default_responsibility_id" t-value="5"/>
            <t t-set="selected_responsibility" t-value="('l10n_ar_afip_responsibility_type_id' in checkout and checkout['l10n_ar_afip_responsibility_type_id']) or default_responsibility_id"/>
            <t t-foreach="responsibility_types or []" t-as="resp_type">
                <option t-att-value="resp_type.id" t-att-selected="resp_type.id == selected_responsibility">
                    <t t-esc="resp_type.name"/>
                </option>
            </t>
        </xpath>


        <!-- Set default ID Type "DNI" (ID: 5) - inject, hide div -->
        <xpath expr="//select[@name='l10n_latam_identification_type_id']" position="inside">
            <t t-set="default_identification_id" t-value="5"/>
            <t t-set="selected_identification" t-value="('l10n_latam_identification_type_id' in checkout and checkout['l10n_latam_identification_type_id']) or default_identification_id"/>
            <t t-foreach="identification_types or []" t-as="id_type">
                <option t-att-value="id_type.id" t-att-selected="id_type.id == selected_identification">
                    <t t-esc="id_type.name"/>
                </option>
            </t>
        </xpath>

    </template>
        <!-- Inherit coupon form: hide the entire form -->
    <template id="simplify_coupon_form" inherit_id="website_sale.coupon_form">
        <xpath expr="//form[@name='coupon_code']" position="attributes">
            <attribute name="style">display: none;</attribute> <!-- Hide coupon form completely -->
        </xpath>
    </template>
</odoo>