<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit cart totals template: hide subtotal and taxes for simplified UX -->
    <template id="simplify_cart_total" inherit_id="website_sale.total">
        <!-- Hide subtotal (order_total_untaxed) -->
        <xpath expr="//tr[@id='order_total_untaxed']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <!-- Hide taxes (order_total_taxes) -->
        <xpath expr="//tr[@id='order_total_taxes']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </template>
    <!-- Inherit address template (website_sale.address): set defaults, hide all except name/email/phone -->
    <template id="simplify_address_defaults" inherit_id="website_sale.address">
        <!-- Default country is Argentina when the partner has none. Keep a saved country. -->
        <xpath expr="//select[@name='country_id']" position="replace">
            <t t-set="sc_country" t-value="country or env.ref('base.ar').sudo()"/>
            <select id="o_country_id" name="country_id" class="form-select">
                <option value="">Country...</option>
                <t t-foreach="countries" t-as="c">
                    <option t-att-value="c.id" t-att-selected="c.id == sc_country.id" t-att-code="c.code">
                        <t t-esc="c.name"/>
                    </option>
                </t>
            </select>
        </xpath>
        <!-- Buenos Aires by xmlid when Argentina has no saved state. Do not pick by position. -->
        <xpath expr="//div[@id='div_state']" position="replace">
            <t t-set="sc_states" t-value="sc_country.sudo().state_ids"/>
            <t t-set="sc_ba" t-value="env.ref('base.state_ar_b', False).sudo()"/>
            <t t-set="sc_state_id" t-value="state_id or (sc_country.code == 'AR' and sc_ba and sc_ba.id) or False"/>
            <div id="div_state" class="col-lg-6 mb-2" t-att-style="not sc_states and 'display: none'">
                <label class="col-form-label" for="o_state_id">State / Province</label>
                <select id="o_state_id" name="state_id" class="form-select">
                    <option value="">State / Province...</option>
                    <t t-foreach="sc_states" t-as="s">
                        <option t-att-value="s.id" t-att-selected="s.id == sc_state_id" t-att-data-code="s.code">
                            <t t-esc="s.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
        <!-- Hide company_name (if B2B) -->
        <xpath expr="//div[@id='company_name_div']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <!-- Set default VAT: 12345678 -->
        <xpath expr="//input[@name='vat']" position="attributes">
            <attribute name="t-att-value">(checkout and 'vat' in checkout and checkout['vat']) or '12345678'</attribute>
        </xpath>
        <!-- Set default street: ejemplo 1234 -->
        <xpath expr="//input[@name='street']" position="attributes">
            <attribute name="t-att-value">(checkout and 'street' in checkout and checkout['street']) or 'ejemplo 1234'</attribute>
        </xpath>
        <!-- Hide street2 div -->
        <xpath expr="//div[label[@for='o_street2']]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <!-- Set default city: CABA -->
        <xpath expr="//input[@name='city']" position="attributes">
            <attribute name="t-att-value">(checkout and 'city' in checkout and checkout['city']) or 'CABA'</attribute>
        </xpath>
        <!-- Set default zip: 8000 - replace in first block (zip before city) -->
        <xpath expr="//t[@t-if='zip_before_city']//input[@name='zip']" position="replace">
            <input id="o_zip" type="text" name="zip" class="form-control" t-att-value="(checkout and 'zip' in checkout and checkout['zip']) or '8000'"/>
        </xpath>
        <!-- Set default zip: 8000 - replace in second block (zip after city) -->
        <xpath expr="//t[@t-if='not zip_before_city']//input[@name='zip']" position="replace">
            <input id="o_zip" type="text" name="zip" class="form-control" t-att-value="(checkout and 'zip' in checkout and checkout['zip']) or '8000'"/>
        </xpath>
        <!-- Set default email: ejemplo@ejemplo.com (visible) -->
        <xpath expr="//input[@name='email']" position="attributes">
            <attribute name="t-att-value">(checkout and 'email' in checkout and checkout['email']) or 'ejemplo@ejemplo.com'</attribute>
        </xpath>
    </template>
    <!-- Change payment submit button label -->
    <template id="simplify_payment_submit_button" inherit_id="payment.submit_button">
        <xpath expr="//button[@name='o_payment_submit_button']" position="before">
            <t t-set="submit_button_label">Confirmar reserva</t>
        </xpath>
    </template>
    <!-- Inherit l10n_ar partner info: set defaults and hide blocks -->
    <template id="simplify_ar_partner_info_defaults" inherit_id="l10n_ar_website_sale.partner_info">
        <!-- Set default AFIP Responsibility (ID: 5) - replace options to avoid duplicates and set selected -->
        <xpath expr="//select[@name='l10n_ar_afip_responsibility_type_id']" position="replace">
            <select name="l10n_ar_afip_responsibility_type_id" class="form-select">
                <option value="">Select...</option> <!-- Assuming original has empty option; adjust if needed -->
                <t t-set="default_responsibility_id" t-value="5"/>
                <t t-set="selected_responsibility" t-value="(checkout and 'l10n_ar_afip_responsibility_type_id' in checkout and checkout['l10n_ar_afip_responsibility_type_id']) or default_responsibility_id"/>
                <t t-foreach="responsibility_types or []" t-as="resp_type">
                    <option t-att-value="resp_type.id" t-att-selected="resp_type.id == selected_responsibility">
                        <t t-esc="resp_type.name"/>
                    </option>
                </t>
            </select>
        </xpath>
        <!-- Set default ID Type "DNI" (ID: 5) - replace options to avoid duplicates and set selected -->
        <xpath expr="//select[@name='l10n_latam_identification_type_id']" position="replace">
            <select name="l10n_latam_identification_type_id" class="form-select">
                <option value="">Select...</option> <!-- Assuming original has empty option; adjust if needed -->
                <t t-set="default_identification_id" t-value="5"/>
                <t t-set="selected_identification" t-value="(checkout and 'l10n_latam_identification_type_id' in checkout and checkout['l10n_latam_identification_type_id']) or default_identification_id"/>
                <t t-foreach="identification_types or []" t-as="id_type">
                    <option t-att-value="id_type.id" t-att-selected="id_type.id == selected_identification">
                        <t t-esc="id_type.name"/>
                    </option>
                </t>
            </select>
        </xpath>
    </template>
    <!-- Inherit coupon form: hide the entire form -->
    <template id="simplify_coupon_form" inherit_id="website_sale.coupon_form">
        <xpath expr="//form[@name='coupon_code']" position="attributes">
            <attribute name="style">display: none;</attribute> <!-- Hide coupon form completely -->
        </xpath>
    </template>
</odoo>